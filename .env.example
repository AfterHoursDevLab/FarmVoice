# ---- API server ----
PORT=4000

# ---- AssemblyAI (required for the voice agent) ----
# Get a key at https://www.assemblyai.com/app
# Keep this server-side only. NEVER put it in the browser bundle.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Temp token minted for each browser session (1-600)
TOKEN_EXPIRES_IN_SECONDS=300
# Max voice session length in seconds (60-10800)
MAX_SESSION_DURATION_SECONDS=3600

# ---- Postgres (optional in Phase 1) ----
# Leave empty to run the farm state fully in-memory (no database needed).
# DATABASE_URL=postgres://farmvoice:farmvoice@127.0.0.1:5432/farmvoice

# ---- Farm simulator ----
SIMULATOR_INTERVAL_MS=5000

# ---- Web dashboard ----
# Used by the browser to reach the API server.
NEXT_PUBLIC_API_URL=http://localhost:4000